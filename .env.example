# Front-end (Vite) — public, safe to ship to the browser.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Stripe Price IDs created by `node scripts/stripe-setup.mjs`.
# (Public identifiers — not secret keys.)
VITE_STRIPE_PRICE_2500=price_xxxxxxxxxxxx
VITE_STRIPE_PRICE_10000=price_xxxxxxxxxxxx
VITE_STRIPE_PRICE_50000=price_xxxxxxxxxxxx
VITE_STRIPE_PRICE_250000=price_xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets — set with `supabase secrets set`, NEVER here
# and NEVER prefixed with VITE_ (those leak to the browser).
#   supabase secrets set \
#     APIFY_TOKEN=apify_api_... \
#     STRIPE_SECRET_KEY=sk_live_... \
#     STRIPE_WEBHOOK_SECRET=whsec_...
#   # SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
#   # into every function automatically — do not set them manually.
# ---------------------------------------------------------------------------
